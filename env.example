# Copy this file to ".env" and fill in your own values.
# NEVER commit your real .env (it's in .gitignore).

# The secret you also set in your GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# A GitHub personal access token with "repo" scope.
GITHUB_TOKEN=ghp_your_github_token

# Your Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-your-key

# Local Postgres + Redis (match your docker containers).
DATABASE_URL=postgresql://reviewer:reviewer_secret@localhost:5432/ai_reviewer
REDIS_URL=redis://localhost:6379
